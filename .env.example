# ==========================================
# GENZ SPORTS // ENVIRONMENT VARIABLES FOR VERCEL
# ==========================================
# Add these in Vercel Dashboard -> Project Settings -> Environment Variables

# 1. Supabase Project URL
VITE_SUPABASE_URL=https://xoizeqnphqtjjyodcfwk.supabase.co

# 2. Supabase Anon / Publishable API Key
VITE_SUPABASE_ANON_KEY=sb_publishable_IijJ_4VjjFEgHOOb2PGDzQ_iwHMV5iO

# (Optional / Alternative Key Name)
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_IijJ_4VjjFEgHOOb2PGDzQ_iwHMV5iO

# Sandbox payments: leave disabled on production. Use a separate Supabase sandbox
# project for BOTH the frontend catalog/auth settings above and the database below.
VITE_STRIPE_PAYMENTS_ENABLED=false
STRIPE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DATABASE_URL=
# Optional PEM CA certificate for the sandbox database (verified TLS is required).
STRIPE_DATABASE_CA=
STRIPE_SANDBOX_DATABASE_CONFIRMED=false
SITE_URL=http://localhost:5173
# Hosted Checkout does not require a publishable key or Stripe.js in the browser.
